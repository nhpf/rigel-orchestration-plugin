---
# Local example. Customize the image and StorageClass before deploying.
vars:
  distro: "noetic"
  image: "your-registry/your-ros-app:latest"

application:
  distro: "{{ vars.distro }}"

jobs:
  deploy_k8s:
    plugin: "src.plugin.OrchestrationPlugin"
    with:
      orchestration:
        namespace: "default"
        application_image: "{{ vars.image }}"
        deploy_ros_master: true
        readiness:
          command: "/usr/local/bin/readiness_probe.sh"
          timeout_seconds: 120
        persistent_storage:
          volumes:
            - name: "results"
              size: "1Gi"
              storage_class: "standard"
              mount_path: "/results"
        results:
          source_path: "/results"
          container: "ros-app"
        rolling_update:
          strategy: "Rolling"
          max_surge: 1
          max_unavailable: 0
        observability:
          enabled: false
