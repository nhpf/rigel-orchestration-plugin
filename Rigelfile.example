---
# Standalone rigel-k8s configuration.
# Copy this file to Rigelfile, set the image and storage class, then run:
#   poetry run rigel-k8s Rigelfile --dry-run
#   poetry run rigel-k8s Rigelfile
#   poetry run rigel-k8s Rigelfile --collect-results ./collected-results

vars:
  distro: "noetic"
  image: "your-registry/your-ros-app:latest"

application:
  distro: "{{ vars.distro }}"

jobs:
  deploy_k8s:
    plugin: "src.plugin.OrchestrationPlugin"
    with:
      orchestration:
        namespace: "default"
        deployment_name: "rigel-k8s-application"
        application_image: "{{ vars.image }}"
        deploy_ros_master: true

        readiness:
          # This executable must exist in the application image.
          command: "/usr/local/bin/readiness_probe.sh"
          timeout_seconds: 120

        persistent_storage:
          volumes:
            - name: "results"
              size: "1Gi"
              # Change this to a StorageClass available in the target cluster.
              storage_class: "standard"
              mount_path: "/results"

        results:
          # The application is responsible for writing its output here.
          source_path: "/results"
          container: "ros-app"

        rolling_update:
          strategy: "Rolling"
          max_surge: 1
          max_unavailable: 0

        distributed:
          enabled: false
          default_to_remote: false
          force_local_flag: false

        observability:
          enabled: false

        additional_k8s_params:
          application:
            spec:
              template:
                spec:
                  containers:
                    - name: "ros-app"
                      env:
                        - name: "RUN_VERSION"
                          value: "{{ vars.image | regex_replace('.*:', '') }}"
